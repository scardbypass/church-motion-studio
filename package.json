{
  "name": "church-motion-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Offline worship lyrics motion editor",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "id.churchmotion.studio",
    "productName": "Church Motion Studio",
    "files": [
      "main.js",
      "index.html",
      "README.md"
    ],
    "win": {
      "target": "nsis"
    }
  }
}